# Operation Nexus — environment configuration template
# Copy this file to .env if you want to override defaults. Nothing in this
# prototype requires secret values (no external API keys are used), but the
# pattern is here so the project is ready to add real configuration later
# without hardcoding anything into source files.

# Host/port the backend API binds to
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000

# Base URL the frontend uses to reach the backend (must match the above)
NEXUS_API_BASE=http://127.0.0.1:8000

# Set to "1" to force a full reseed of the synthetic dataset on every
# backend startup (useful while developing; leave unset for normal use,
# where the existing nexus.db is reused between restarts).
NEXUS_FORCE_RESEED=0
